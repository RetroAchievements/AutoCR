{
  "name": "autocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .hooks",
    "dev": "bun ./index.html --console",
    "build": "bun build ./index.html --production --sourcemap=linked --outdir=dist",
    "start": "bunx serve dist/ -l 8080",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@nkzw/eslint-plugin": "2.0.0",
    "@nkzw/oxlint-config": "2.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  }
}
